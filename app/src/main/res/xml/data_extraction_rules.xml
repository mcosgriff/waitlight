<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12 and up. Keep in step with backup_rules.xml.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- The last waits (WaitTimesStore.FILE_NAME): minutes old at best, so not worth restoring. -->
    <!-- The last location found (LastLocationStore.FILE_NAME), for the widget: it stays on this phone. -->
    <cloud-backup>
        <exclude domain="file" path="waits.json" />
        <exclude domain="file" path="location.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="waits.json" />
        <exclude domain="file" path="location.txt" />
    </device-transfer>
</data-extraction-rules>
