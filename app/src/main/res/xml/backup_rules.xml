<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and lower; Android 12 and up read data_extraction_rules.xml. Keep the two in step.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- The user's own records, drive_bys.json and vehicles.json, are backed up: everything not excluded here is. -->
    <!-- The last waits (WaitTimesStore.FILE_NAME): minutes old at best, so not worth restoring. -->
    <exclude domain="file" path="waits.json" />
    <!-- The last location found (LastLocationStore.FILE_NAME), for the widget: it stays on this phone. -->
    <exclude domain="file" path="location.txt" />
    <!-- The last van schedule (VanStore.FILE_NAME): this week's at best. -->
    <exclude domain="file" path="vans.json" />
</full-backup-content>
